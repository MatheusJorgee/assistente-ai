# ============================================================================
# .env.example
# Copie para backend/.env e preencha os valores
# ============================================================================

# ============================================================================
# Google Gemini API
# ============================================================================
# Obter em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua-chave-api-aqui
GEMINI_MODEL=gemini-1.5-pro

# Modelos alternativos (se quiser testar):
# GEMINI_MODEL=gemini-2.0-flash      # Mais rápido, menos preciso
# GEMINI_MODEL=gemini-1.5-flash      # Balanço entre speed/accuracy

# ============================================================================
# Spotify API (opcional)
# ============================================================================
# Obter em: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080

# ============================================================================
# Busca Web (perguntas factuais em tempo real no chat)
# ============================================================================
# Tavily: busca confiável feita para IA. Free tier em https://tavily.com
# Sem ela, o assistente usa scraping do DuckDuckGo (best-effort, rate-limita).
TAVILY_API_KEY=

# ============================================================================
# Hologramas (globo + viagem). Dados abertos, sem chave. Sai para a internet o
# nome do lugar, coordenadas e datas (OpenStreetMap, Wikivoyage, Open-Meteo).
# ============================================================================
HOLO_ENABLED=true
# Contato no User-Agent (exigido pela politica do Nominatim). Ex.: seu e-mail.
HOLO_CONTACT=
HOLO_DEADLINE_S=14

# ============================================================================
# Briefing Matinal (clima + notícias ao iniciar o PC)
# ============================================================================
# Clima via OpenWeather. Gere uma chave grátis em: https://openweathermap.org/api
OPENWEATHER_API_KEY=
# Cidade do briefing (formato "Cidade,PAIS"):
BRIEFING_CITY=Sao Paulo,BR
# Quantas manchetes incluir:
BRIEFING_NEWS_COUNT=5
# Falar o briefing automaticamente quando o backend iniciar (true/false).
# Para o auto-start do PC, o launcher já dispara o briefing — deixe false aqui.
BRIEFING_ON_STARTUP=false

# ============================================================================
# Segurança e Comportamento
# ============================================================================
# Profiles: trusted-local (permissivo), strict (restritivo)
QUINTA_SECURITY_PROFILE=trusted-local

# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# WebSocket (opcional - defaults funcionam em localhost)
# ============================================================================
# Estas variáveis sobrem em: frontend/.env.local ou Vercel
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/chat
NEXT_PUBLIC_WS_HOST=localhost
NEXT_PUBLIC_WS_PORT=8000
NEXT_PUBLIC_WS_PATH=/ws/chat

# ============================================================================
# Debug (opcional)
# ============================================================================
NEXT_PUBLIC_DEBUG=false

# ============================================================================
# NOTAS IMPORTANTES
# ============================================================================
#
# 1. GEMINI_API_KEY é OBRIGATÓRIO
#    - Sem ela, o Brain não inicializa
#    - Gerar em: https://aistudio.google.com/app/apikey
#
# 2. Para desenvolvimento local
#    - Use NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/chat
#
# 3. Para deploy Vercel + Backend Local (via ngrok)
#    - Obter URL ngrok: ngrok http 8000
#    - Adicionar em Vercel: NEXT_PUBLIC_WS_URL=wss://xxx.ngrok.io/ws/chat
#    - (Note: wss:// para HTTPS)
#
# 4. NÃO commitar este arquivo com valores reais
#    - Use: git update-index --assume-unchanged backend/.env
#    - Ou adicione em .gitignore
#
# ============================================================================

# ============================================================================
# CUSTO x INTELIGENCIA (opcional — os padroes ja sao os recomendados)
# ============================================================================
# Politica por funcao: tarefas de fundo sem raciocinio, classificadores no modelo lite.
# LLM_POLICY_ENABLED=false volta ao comportamento antigo (thinking dinamico em tudo).
# LLM_POLICY_ENABLED=true
# GEMINI_MODEL_LITE=gemini-2.5-flash-lite
# Modelo forte: so no MODO AGENTE (objetivo multi-passo). Mais caro por token.
# GEMINI_MODEL_STRONG=gemini-2.5-pro
# STRONG_MODEL_ENABLED=true
# Tetos de raciocinio (tokens): pergunta complexa e modo agente
# COMPLEX_THINKING_BUDGET=4096
# STRONG_THINKING_BUDGET=8192
# Contexto variavel (memoria/hora/humor) no fim da mensagem, mantendo o prefixo estavel p/ cache
# CONTEXT_IN_USER_TURN=true
# Teto de caracteres da saida de uma tool que volta ao LLM
# TOOL_OUTPUT_MAX_CHARS=7000
# Registro de tokens/custo por funcao (veja em GET /custo)
# LLM_LEDGER_ENABLED=true

# Streaming da resposta do chat: o texto aparece e a voz comeca frase a frase enquanto o modelo
# ainda escreve. So vale para o chat pelo WebSocket. false = espera a resposta inteira (antigo).
# STREAM_RESPONSES=true
# Tempo maximo (s) de uma volta em streaming; o modelo forte ganha o dobro.
# STREAM_TIMEOUT_SECONDS=30
